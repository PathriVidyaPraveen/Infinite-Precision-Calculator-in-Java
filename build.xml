<project name="MyInfArithProject" default="run" basedir=".">

    
    <property name="src.dir" value="arbitraryarithmetic"/>
    <property name="build.dir" value="build"/>
    <property name="jar.name" value="aarithmetic.jar"/>

    
    <target name="clean">
        <delete dir="${build.dir}" />
        <delete file="${src.dir}/${jar.name}" />
    </target>

    
    <target name="compile">
        <mkdir dir="${build.dir}" />
        <javac srcdir="${src.dir}" destdir="${build.dir}">
            <include name="AInteger.java"/>
            <include name="AFloat.java"/>
        </javac>
    </target>

    
    <target name="jar" depends="compile">
        <jar destfile="${src.dir}/${jar.name}" basedir="${build.dir}" />
    </target>

    
    <target name="compile-main" depends="jar">
        <javac srcdir="." destdir="${build.dir}" classpath="${src.dir}/${jar.name}">
            <include name="MyInfArith.java"/>
        </javac>
    </target>

    
    <target name="run" depends="compile-main">
        <java classname="MyInfArith" fork="true" classpath="${build.dir}:${src.dir}/${jar.name}">
            <arg value="int"/>
            <arg value="add"/>
            <arg value="123"/>
            <arg value="456"/>
        </java>
    </target>

</project>
